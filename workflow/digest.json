        "jsCode": "const start = new Date();\nstart.setHours(0, 0, 0, 0);\nconst limit = new Date(start.getTime() + 7 * 24 * 60 * 60 * 1000);\n\nconst rows = $input.all().filter(i => {\n  const raw = i.json.deadline || i.json.Deadline;\n  const d = new Date(raw);\n  return raw && d >= start && d <= limit;\n});\n\nif (!rows.length) {\n  return [{ json: { text: \"No deadlines in the next 7 days.\" } }];\n}\n\nconst lines = rows.map(i =>\n  `- ${i.json.company || i.json.Company}, ${i.json.role || i.json.Role} (due ${i.json.deadline || i.json.Deadline}) [${i.json.decision || i.json.Decision}]`\n);\nreturn [{ json: { text: \"Deadlines this week:\\n\" + lines.join(\"\\n\") } }];"
      },
